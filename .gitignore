# Each Unreal project (UnrealWorld/, Handheld/) has its own .gitignore.

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

.blend1
# Local tool state
.claude/settings.local.json

Archive/
# Art holds the big binaries (blends, textures). Its scripts and notes are tracked.
Art/*
!Art/tools/
Art/tools/*.npz
!Art/*.md